target/
app/dist/
app/src-tauri/gen/

# Runtime artifacts
state.json
mcp-list-cache.json
activate.log
scratch/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs and temp
*.log
tmp/
