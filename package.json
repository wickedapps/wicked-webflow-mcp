{
  "name": "wicked-webflow-mcp",
  "version": "0.7.0",
  "description": "Keep every client's Webflow MCP connection live at once, and load only the ones each project needs.",
  "type": "module",
  "bin": {
    "wwm": "./bin/wwm"
  },
  "files": [
    "bin/wwm"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "app:build": "npm --prefix app run build",
    "version:check": "node scripts/release.mjs check",
    "release": "node scripts/release.mjs stamp",
    "release:github": "node scripts/release.mjs github",
    "prepublishOnly": "npm run version:check && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wickedapps/wicked-webflow-mcp.git"
  },
  "homepage": "https://github.com/wickedapps/wicked-webflow-mcp",
  "bugs": {
    "url": "https://github.com/wickedapps/wicked-webflow-mcp/issues"
  },
  "keywords": [
    "webflow",
    "mcp",
    "claude-code",
    "agency",
    "cli"
  ],
  "license": "ISC"
}
