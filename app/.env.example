# Leave unused keys commented. An empty APPLE_ID is enough for Tauri to
# attempt notarization and then fail.

APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
APPLE_TEAM_ID=

# Notarization via Apple ID — password is an app-specific password from
# appleid.apple.com, not the account password.
# APPLE_ID=
# APPLE_PASSWORD=

# Or notarization via App Store Connect API (better for CI):
# APPLE_API_KEY=
# APPLE_API_ISSUER=
# APPLE_API_KEY_PATH=
