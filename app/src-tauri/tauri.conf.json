{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wicked Webflow MCP Manager",
  "mainBinaryName": "Wicked Webflow MCP Manager",
  "version": "0.7.0",
  "identifier": "com.wickedapps.wicked-webflow",
  "build": {
    "runner": "./dev-runner.sh",
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wicked Webflow MCP Manager",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "resources": {
      "../../bin/wwm": "bin/wwm"
    },
    "shortDescription": "Manage multiple Webflow MCP connections for Claude Code",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
