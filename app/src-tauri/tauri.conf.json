{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wicked Webflow MCP Manager",
  "version": "0.5.1",
  "identifier": "com.wickedapps.wicked-webflow",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wicked Webflow MCP Manager",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Per-client Webflow MCP connections for Claude Code",
    "icon": ["icons/icon.png"]
  }
}
